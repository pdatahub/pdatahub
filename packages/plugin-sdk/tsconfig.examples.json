{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "./dist/examples",
    "rootDir": "./",
    "declaration": false,
    "sourceMap": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": false,
    "experimentalDecorators": true
  },
  "include": ["examples/**/*", "src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}