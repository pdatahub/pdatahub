<?xml version="1.0" encoding="utf-8"?>
<!--
  Allow cleartext HTTP for development/debug builds.

  In production this should be tightened to HTTPS-only with
  proper certificate validation. Debug builds need cleartext for:
    - 127.0.0.1 (adb reverse from laptop to phone over USB)
    - 192.168.x.x (direct WiFi between phone and laptop on same LAN)
    - 100.64.0.0/10 (Tailscale CGNAT range)
    - *.ts.net (Tailscale MagicDNS)
    - 10.0.2.2 (Android emulator → host loopback)
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
