#cloud-config
# Generated by pdatahub-runner (Phase 1A skeleton).
# DO NOT EDIT BY HAND — re-run runner to regenerate.
# Hostname:    v-test01
# AdminEmail:  golden@pdatahub.io
# HubVersion:  v0.1.0
# Tailnet:     cloud.pdatahub.io

package_update: true
package_upgrade: false

write_files:
  - path: /etc/systemd/system/pdatahub-hub.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=pdatahub hub-core (v-test01, admin=golden@pdatahub.io)
      After=network-online.target tailscaled.service
      Wants=network-online.target
      Requires=tailscaled.service

      [Service]
      Type=simple
      User=root
      WorkingDirectory=/opt/pdatahub/hub-core
      EnvironmentFile=/etc/pdatahub/hub.env
      ExecStart=/usr/bin/env node /opt/pdatahub/hub-core/dist/index.js
      Restart=on-failure
      RestartSec=5s
      LimitNOFILE=65536

      [Install]
      WantedBy=multi-user.target
  - path: /etc/pdatahub/hub.env
    owner: root:root
    permissions: '0600'
    content: |
      HUB_API_TOKEN=deadbeefcafebabe0011223344556677aabbccdd0011223344556677aabbccdd
      HUB_LISTEN_ADDR=0.0.0.0:8080
      HUB_PUBLIC_HOSTNAME=v-test01.cloud.pdatahub.io
      HUB_TAILSCALE_DOMAIN=cloud.pdatahub.io

runcmd:
  - set -euo pipefail
  - echo '[pdatahub] install start: host=v-test01 admin=golden@pdatahub.io version=v0.1.0' > /var/log/pdatahub-install.log
  - DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends curl jq ca-certificates
  - if ! command -v tailscale >/dev/null 2>&1; then curl -fsSL https://tailscale.com/install.sh | sh; fi
  - if ! tailscale status --json 2>/dev/null | grep -q 'BackendState\":\"Running'; then tailscale up --authkey=tskey-fake-GOLDEN-001 --hostname=v-test01; fi
  - echo '[pdatahub] tailscale registered as v-test01.cloud.pdatahub.io' >> /var/log/pdatahub-install.log
  - mkdir -p /opt/pdatahub/hub-core
  - if [ ! -f /opt/pdatahub/hub-core/.installed-version ] || [ "$(cat /opt/pdatahub/hub-core/.installed-version)" != "v0.1.0" ]; then echo '[pdatahub] installing hub-core v0.1.0' >> /var/log/pdatahub-install.log; curl -fsSL https://github.com/pdatahub/pdatahub/releases/download/v0.1.0/pdatahub-hub-core-v0.1.0.tgz -o /tmp/hub-core.tgz; tar -xzf /tmp/hub-core.tgz -C /opt/pdatahub/hub-core --strip-components=1; echo "v0.1.0" > /opt/pdatahub/hub-core/.installed-version; rm -f /tmp/hub-core.tgz; fi
  - systemctl daemon-reload
  - systemctl enable pdatahub-hub.service
  - systemctl restart pdatahub-hub.service || systemctl start pdatahub-hub.service
  - for i in $(seq 1 30); do if curl -fsS http://127.0.0.1:8080/v1/identity >/dev/null 2>&1; then echo '[pdatahub] hub-core ready after '"$i"'s' >> /var/log/pdatahub-install.log; exit 0; fi; sleep 1; done
  - echo '[pdatahub] WARNING: hub-core did not become ready within 30s. Check: journalctl -u pdatahub-hub.service' >> /var/log/pdatahub-install.log
