# Copy to .env and customize. .env is gitignored — never commit.

# HUB_API_TOKEN — bearer token for HTTP API.
# Leave empty to auto-generate on first `docker compose up`.
# Once generated, persisted to /data/.env and reused across restarts.
# Regenerate by deleting the line from /data/.env and restarting.
HUB_API_TOKEN=

# Cloudflare Tunnel token (optional) — for HTTPS OAuth callbacks.
# Get from https://one.dash.cloudflare.com → Zero Trust → Tunnels.
# CLOUDFLARE_TUNNEL_TOKEN=
